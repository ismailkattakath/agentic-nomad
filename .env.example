# Mirrors envCatalogue in flake.nix. Values intentionally BLANK — never commit a real secret.
# Prefer .envrc.local (computes from the Keychain) or `secret exec` over a plaintext .env.

# LiteAPI SANDBOX key (keys are environment-specific): rates search.
LITEAPI_API_KEY=

# Duffel duffel_test_ token, for the unbuilt fallback rail (ADR-0001). Use test tokens only; nothing checks the prefix any more.
DUFFEL_ACCESS_TOKEN=

# Bland voice MCP, for later; the server is disabled in settings.json.
BLAND_API_KEY=

# No effect since the spend guard was removed (2026-10-27); kept so this file mirrors envCatalogue.
NOMAD_ALLOW_LIVE=
