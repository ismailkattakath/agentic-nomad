# direnv: the dev shell plus this repo's own secrets, scoped to this directory.
# Run `direnv allow` once. Values never live here — see .envrc.local below.
use flake

dotenv_if_exists .env

# Per-operator, gitignored SHELL file that COMPUTES secrets instead of storing them, e.g.
#   export LITEAPI_API_KEY="$(security find-generic-password -s agentic-nomad-liteapi-sandbox -w)"
# On the kattakath fleet the sandbox key is a Keychain secret bound to its env name
# (`secret set --env LITEAPI_API_KEY liteapi:liteapi.travel:sandbox`), so it is already exported.
# Store LIVE keys with --no-export instead and launch with the wrapper:
#   secret exec LITEAPI_API_KEY=liteapi:liteapi.travel:live -- claude
source_env_if_exists .envrc.local
